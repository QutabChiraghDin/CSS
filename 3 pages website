<!DOCTYPE html>
<html>
<head>
    <title>My 3 Page Website</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f4f4;
        }

        /* Navigation Bar */
        nav {
            background: #222;
            padding: 18px;
            text-align: center;
            position: sticky;
            top: 0;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 25px;
            font-size: 18px;
            cursor: pointer;
        }

        nav a:hover {
            color: #00bcd4;
        }

        /* Pages */
        .page {
            min-height: 90vh;
            padding: 80px 20px;
            text-align: center;
            display: none;
        }

        #home {
            display: block;
        }

        h1 {
            font-size: 40px;
            color: #222;
        }

        p {
            font-size: 18px;
            color: #555;
        }

        /* Button */
        button {
            padding: 12px 25px;
            background: #00bcd4;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background: #0097a7;
        }

        /* Contact Form */
        input,
        textarea {
            width: 300px;
            padding: 12px;
            margin: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        textarea {
            height: 100px;
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <a onclick="showPage('home')">Home</a>
        <a onclick="showPage('about')">About</a>
        <a onclick="showPage('contact')">Contact</a>
    </nav>

    <!-- Home Page -->
    <section id="home" class="page">
        <h1>Welcome to My Website</h1>
        <p>This is my Home Page.</p>
        <button onclick="showPage('about')">Learn More</button>
    </section>

    <!-- About Page -->
    <section id="about" class="page">
        <h1>About Us</h1>
        <p>Welcome to our website.</p>
        <p>We are learning HTML, CSS and JavaScript.</p>
        <button onclick="showPage('contact')">Contact Us</button>
    </section>

    <!-- Contact Page -->
    <section id="contact" class="page">
        <h1>Contact Us</h1>

        <input type="text" placeholder="Your Name">
        <br>

        <input type="email" placeholder="Your Email">
        <br>

        <textarea placeholder="Your Message"></textarea>
        <br>

        <button>Send Message</button>
    </section>

    <script>
        // Function to show a selected page
        function showPage(pageId) {

            // Hide all pages
            let pages = document.querySelectorAll(".page");

            pages.forEach(function(page) {
                page.style.display = "none";
            });

            // Show selected page
            document.getElementById(pageId).style.display = "block";
        }
    </script>

</body>
</html>
