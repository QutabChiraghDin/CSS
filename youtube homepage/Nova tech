<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NovaTech</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b1020;
            color: white;
        }

        /* ================= NAVBAR ================= */

        nav {
            width: 100%;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(10, 15, 35, 0.9);
            position: fixed;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #00eaff;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #00eaff;
        }

        .nav-btn {
            background: #00eaff;
            color: #07101c !important;
            padding: 10px 18px;
            border-radius: 25px;
            font-weight: bold;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 100px 20px 50px;

            background:
                radial-gradient(circle at 20% 20%, #163b67, transparent 35%),
                radial-gradient(circle at 80% 80%, #3c145e, transparent 35%),
                #0b1020;
        }

        .hero-content {
            max-width: 800px;
            animation: fadeUp 1s ease;
        }

        .hero h1 {
            font-size: 60px;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #00eaff;
        }

        .hero p {
            color: #c5c8d5;
            font-size: 18px;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            margin: 8px;
            border-radius: 30px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .primary {
            background: #00eaff;
            color: #07101c;
        }

        .secondary {
            border: 1px solid #00eaff;
            color: white;
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 234, 255, 0.25);
        }

        /* ================= SECTIONS ================= */

        section {
            padding: 90px 8%;
        }

        .section-title {
            text-align: center;
            font-size: 40px;
            margin-bottom: 50px;
        }

        .section-title span {
            color: #00eaff;
        }

        /* ================= CARDS ================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            padding: 35px;
            background: #121a30;
            border: 1px solid #263451;
            border-radius: 20px;
            transition: 0.4s;
        }

        .card:hover {
            transform: translateY(-10px);
            border-color: #00eaff;
            box-shadow: 0 15px 40px rgba(0, 234, 255, 0.12);
        }

        .icon {
            font-size: 40px;
            margin-bottom: 20px;
        }

        .card h3 {
            margin-bottom: 15px;
            font-size: 23px;
        }

        .card p {
            color: #aeb5c7;
            line-height: 1.6;
        }

        /* ================= ABOUT ================= */

        .about {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-box {
            background: #121a30;
            padding: 40px;
            border-radius: 20px;
        }

        .about h2 {
            font-size: 40px;
            margin-bottom: 20px;
        }

        .about h2 span {
            color: #00eaff;
        }

        .about p {
            color: #b9c0d0;
            line-height: 1.8;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .stat {
            background: #18213a;
            padding: 30px;
            text-align: center;
            border-radius: 15px;
        }

        .stat h3 {
            font-size: 35px;
            color: #00eaff;
        }

        /* ================= CONTACT ================= */

        .contact {
            max-width: 700px;
            margin: auto;
            text-align: center;
        }

        .contact p {
            color: #adb5c7;
            margin-bottom: 30px;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 16px;
            border: 1px solid #2b3854;
            background: #121a30;
            color: white;
            border-radius: 10px;
            outline: none;
        }

        .contact-form textarea {
            height: 150px;
            resize: none;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #00eaff;
        }

        /* ================= FOOTER ================= */

        footer {
            text-align: center;
            padding: 30px;
            background: #070b16;
            color: #8992a7;
        }

        footer span {
            color: #00eaff;
        }

        /* ================= ANIMATION ================= */

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ================= MOBILE ================= */

        @media (max-width: 768px) {

            nav {
                padding: 15px 5%;
            }

            .nav-links {
                gap: 12px;
                font-size: 13px;
            }

            .nav-btn {
                display: none;
            }

            .hero h1 {
                font-size: 42px;
            }

            .hero p {
                font-size: 16px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .about {
                grid-template-columns: 1fr;
            }

            .about h2 {
                font-size: 32px;
            }

            .section-title {
                font-size: 32px;
            }

            section {
                padding: 70px 5%;
            }
        }
    </style>
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <nav>
        <div class="logo">NovaTech</div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
            <li><a href="#contact" class="nav-btn">Get Started</a></li>
        </ul>
    </nav>


    <!-- ================= HOME ================= -->

    <section class="hero" id="home">

        <div class="hero-content">

            <h1>
                Build Something
                <span>Awesome.</span>
            </h1>

            <p>
                We create modern, responsive and high-performance
                digital experiences for the next generation of businesses.
            </p>

            <a href="#services" class="btn primary">
                Explore Services
            </a>

            <a href="#contact" class="btn secondary">
                Contact Us
            </a>

        </div>

    </section>


    <!-- ================= SERVICES ================= -->

    <section id="services">

        <h2 class="section-title">
            Our <span>Services</span>
        </h2>

        <div class="cards">

            <div class="card">
                <div class="icon">💻</div>
                <h3>Web Development</h3>
                <p>
                    Modern and responsive websites built with
                    clean and efficient code.
                </p>
            </div>

            <div class="card">
                <div class="icon">🎨</div>
                <h3>UI/UX Design</h3>
                <p>
                    Beautiful interfaces designed to give users
                    a smooth and enjoyable experience.
                </p>
            </div>

            <div class="card">
                <div class="icon">🚀</div>
                <h3>Digital Solutions</h3>
                <p>
                    Powerful digital solutions designed to help
                    your business grow faster.
                </p>
            </div>

        </div>

    </section>


    <!-- ================= ABOUT ================= -->

    <section id="about">

        <div class="about">

            <div class="about-box">

                <h2>
                    About <span>NovaTech</span>
                </h2>

                <p>
                    NovaTech is a modern digital technology company
                    focused on creating beautiful websites,
                    applications and digital experiences.
                </p>

                <br>

                <p>
                    Our goal is simple: turn ideas into fast,
                    attractive and user-friendly digital products.
                </p>

            </div>

            <div class="stats">

                <div class="stat">
                    <h3>50+</h3>
                    <p>Projects</p>
                </div>

                <div class="stat">
                    <h3>30+</h3>
                    <p>Clients</p>
                </div>

                <div class="stat">
                    <h3>5+</h3>
                    <p>Years Experience</p>
                </div>

                <div class="stat">
                    <h3>24/7</h3>
                    <p>Support</p>
                </div>

            </div>

        </div>

    </section>


    <!-- ================= CONTACT ================= -->

    <section id="contact">

        <div class="contact">

            <h2 class="section-title">
                Let's <span>Talk</span>
            </h2>

            <p>
                Have a project idea? Send us a message.
            </p>

            <form class="contact-form">

                <input
                    type="text"
                    placeholder="Your Name"
                    required
                >

                <input
                    type="email"
                    placeholder="Your Email"
                    required
                >

                <textarea
                    placeholder="Your Message"
                    required
                ></textarea>

                <button class="btn primary" type="submit">
                    Send Message
                </button>

            </form>

        </div>

    </section>


    <!-- ================= FOOTER ================= -->

    <footer>

        <p>
            © 2026 <span>NovaTech</span>.
            All Rights Reserved.
        </p>

    </footer>

</body>
</html>
