<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Website</title>

    <style>
        /* ===== BASIC CSS ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #222;
        }

        /* ===== NAVBAR ===== */
        nav {
            background: #111827;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        nav ul li a:hover {
            color: #38bdf8;
        }

        /* ===== HERO ===== */
        .hero {
            min-height: 80vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
        }

        .hero h1 {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 18px;
            color: #555;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background: #2563eb;
            color: white;
            padding: 12px 25px;
            border-radius: 8px;
            text-decoration: none;
            transition: 0.3s;
        }

        .btn:hover {
            background: #1d4ed8;
            transform: translateY(-3px);
        }

        /* ===== SECTIONS ===== */
        .section {
            padding: 70px 8%;
            text-align: center;
        }

        .section h1 {
            margin-bottom: 20px;
            font-size: 35px;
        }

        /* ===== CARDS ===== */
        .cards {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
            margin-top: 35px;
        }

        .card {
            background: white;
            width: 280px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
        }

        .card h2 {
            margin-bottom: 12px;
        }

        .card p {
            color: #666;
        }

        /* ===== FOOTER ===== */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 50px;
        }

        /* ===== MOBILE ===== */
        @media (max-width: 700px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                gap: 15px;
            }

            .hero h1 {
                font-size: 35px;
            }

            .hero p {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav>
        <div class="logo">MyWebsite</div>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
        </ul>
    </nav>

    <!-- ===== HOME ===== -->
    <section class="hero" id="home">
        <div>
            <h1>Welcome to My Website</h1>
            <p>Simple, modern and responsive website.</p>

            <a href="#services" class="btn">Explore Services</a>
        </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section class="section" id="about">
        <h1>About Us</h1>

        <p>
            We create simple and beautiful websites using
            HTML and CSS.
        </p>
    </section>

    <!-- ===== SERVICES ===== -->
    <section class="section" id="services">
        <h1>Our Services</h1>

        <div class="cards">

            <div class="card">
                <h2>Web Design</h2>
                <p>
                    Modern and responsive website designs.
                </p>
            </div>

            <div class="card">
                <h2>Frontend</h2>
                <p>
                    Clean HTML and CSS frontend development.
                </p>
            </div>

            <div class="card">
                <h2>Responsive</h2>
                <p>
                    Websites that work on mobile and desktop.
                </p>
            </div>

        </div>
    </section>

    <!-- ===== FOOTER ===== -->
    <footer>
        <p>© 2026 MyWebsite | All Rights Reserved</p>
    </footer>

</body>
</html>
