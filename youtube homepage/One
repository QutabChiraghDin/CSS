<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NovaX — Modern Website</title>

    <style>
        /* =========================
           GLOBAL STYLES
        ========================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #080b14;
            color: white;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* =========================
           NAVBAR
        ========================== */

        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;

            display: flex;
            justify-content: space-between;
            align-items: center;

            padding: 18px 8%;

            background: rgba(8, 11, 20, 0.75);
            backdrop-filter: blur(15px);

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .logo span {
            color: #00e5ff;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #ddd;
            transition: 0.3s;
            cursor: pointer;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #00e5ff;
        }

        .menu {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* =========================
           PAGE SYSTEM
        ========================== */

        .page {
            display: none;
            min-height: 100vh;
            padding-top: 80px;
        }

        .page.active {
            display: block;
            animation: pageFade 0.6s ease;
        }

        @keyframes pageFade {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            min-height: calc(100vh - 80px);

            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;

            padding: 40px 8%;

            position: relative;
            overflow: hidden;
        }

        /* Animated background circles */

        .circle {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.35;
            animation: float 7s infinite ease-in-out;
        }

        .circle.one {
            width: 300px;
            height: 300px;
            background: #00e5ff;
            top: 10%;
            left: 5%;
        }

        .circle.two {
            width: 350px;
            height: 350px;
            background: #7c3cff;
            bottom: 5%;
            right: 5%;
            animation-delay: 2s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0) scale(1);
            }

            50% {
                transform: translateY(-40px) scale(1.1);
            }
        }

        .hero-content {
            position: relative;
            z-index: 2;
            max-width: 850px;
        }

        .hero-content small {
            display: inline-block;
            color: #00e5ff;
            border: 1px solid rgba(0,229,255,0.4);
            padding: 8px 18px;
            border-radius: 50px;
            margin-bottom: 20px;
            animation: slideDown 0.8s ease;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 90px);
            line-height: 1;
            margin-bottom: 25px;

            background: linear-gradient(
                90deg,
                #ffffff,
                #00e5ff,
                #8c5cff,
                #ffffff
            );

            background-size: 300%;
            -webkit-background-clip: text;
            color: transparent;

            animation:
                gradientMove 5s infinite,
                slideUp 0.9s ease;
        }

        @keyframes gradientMove {
            0% {
                background-position: 0%;
            }

            50% {
                background-position: 100%;
            }

            100% {
                background-position: 0%;
            }
        }

        @keyframes slideUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes slideDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .hero p {
            color: #aaa;
            font-size: 18px;
            line-height: 1.7;
            max-width: 650px;
            margin: auto;
        }

        .buttons {
            margin-top: 35px;
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border-radius: 50px;
            font-weight: bold;
            cursor: pointer;
            border: none;
            transition: 0.3s;
        }

        .primary {
            background: #00e5ff;
            color: #001014;
        }

        .primary:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,229,255,0.35);
        }

        .secondary {
            background: transparent;
            color: white;
            border: 1px solid #555;
        }

        .secondary:hover {
            border-color: #00e5ff;
            color: #00e5ff;
            transform: translateY(-5px);
        }

        /* =========================
           GENERAL SECTION
        ========================== */

        .container {
            width: 85%;
            max-width: 1200px;
            margin: auto;
            padding: 70px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 45px;
            margin-bottom: 12px;
        }

        .section-title p {
            color: #999;
        }

        /* =========================
           CARDS
        ========================== */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            padding: 35px;
            background: linear-gradient(
                145deg,
                rgba(255,255,255,0.08),
                rgba(255,255,255,0.02)
            );

            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 22px;

            transition: 0.4s;
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            width: 100px;
            height: 100px;
            background: #00e5ff;
            filter: blur(70px);
            opacity: 0;
            transition: 0.4s;
        }

        .card:hover::before {
            opacity: 0.35;
        }

        .card:hover {
            transform: translateY(-12px);
            border-color: rgba(0,229,255,0.4);
        }

        .icon {
            width: 55px;
            height: 55px;

            display: flex;
            justify-content: center;
            align-items: center;

            border-radius: 15px;
            background: rgba(0,229,255,0.1);
            color: #00e5ff;

            font-size: 25px;
            margin-bottom: 25px;
        }

        .card h3 {
            font-size: 22px;
            margin-bottom: 12px;
        }

        .card p {
            color: #999;
            line-height: 1.7;
        }

        /* =========================
           ABOUT PAGE
        ========================== */

        .about-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-image {
            height: 400px;
            border-radius: 25px;

            display: flex;
            justify-content: center;
            align-items: center;

            background:
                radial-gradient(circle at 30% 30%, #00e5ff, transparent 30%),
                radial-gradient(circle at 70% 70%, #7c3cff, transparent 30%),
                #111827;

            animation: imageFloat 5s infinite ease-in-out;
        }

        @keyframes imageFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        .about-image span {
            font-size: 100px;
        }

        .about-text h2 {
            font-size: 45px;
            margin-bottom: 20px;
        }

        .about-text p {
            color: #aaa;
            line-height: 1.8;
            margin-bottom: 20px;
        }

        .stats {
            display: flex;
            gap: 35px;
            margin-top: 30px;
        }

        .stat h3 {
            font-size: 30px;
            color: #00e5ff;
        }

        .stat p {
            margin: 0;
            font-size: 14px;
        }

        /* =========================
           CONTACT PAGE
        ========================== */

        .contact-box {
            max-width: 700px;
            margin: auto;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            padding: 40px;
            border-radius: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #ddd;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 15px;

            background: #111522;
            border: 1px solid #333;
            border-radius: 12px;

            color: white;
            outline: none;
            font-size: 16px;
        }

        .form-group textarea {
            height: 150px;
            resize: none;
        }

        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #00e5ff;
        }

        .submit {
            width: 100%;
            font-size: 16px;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #05070d;
            border-top: 1px solid rgba(255,255,255,0.08);
            text-align: center;
            padding: 30px 20px;
            color: #777;
        }

        footer span {
            color: #00e5ff;
        }

        /* =========================
           MOBILE RESPONSIVE
        ========================== */

        @media (max-width: 800px) {

            .menu {
                display: block;
            }

            .nav-links {
                position: absolute;
                top: 70px;
                left: 0;

                width: 100%;

                flex-direction: column;
                align-items: center;

                padding: 25px;

                background: rgba(8,11,20,0.97);

                display: none;
            }

            .nav-links.show {
                display: flex;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .about-box {
                grid-template-columns: 1fr;
            }

            .about-image {
                height: 300px;
            }

            .about-text h2 {
                font-size: 35px;
            }

            .stats {
                justify-content: space-between;
            }
        }

        @media (max-width: 500px) {

            nav {
                padding: 16px 5%;
            }

            .hero {
                padding: 30px 5%;
            }

            .hero p {
                font-size: 16px;
            }

            .section-title h2 {
                font-size: 35px;
            }

            .container {
                width: 90%;
            }

            .contact-box {
                padding: 25px;
            }
        }
    </style>
</head>

