<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Website</title>

    <style>
        /* ---------- Basic Reset ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f7fa;
            color: #222;
        }

        /* ---------- Navbar ---------- */
        nav {
            background: #111827;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        .nav-links {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        .nav-links a:hover {
            color: #38bdf8;
        }

        /* ---------- Hero Section ---------- */
        .hero {
            min-height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
            color: white;
        }

        .hero h1 {
            font-size: 55px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 19px;
            margin-bottom: 30px;
            color: #dbeafe;
        }

        .btn {
            display: inline-block;
            padding: 13px 28px;
            background: #38bdf8;
            color: #111827;
            text-decoration: none;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-4px);
            background: white;
        }

        /* ---------- Cards ---------- */
        .services {
            padding: 70px 8%;
            text-align: center;
        }

        .services h2 {
            font-size: 35px;
            margin-bottom: 40px;
        }

        .cards {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            width: 280px;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
        }

        .card h3 {
            margin-bottom: 15px;
        }

        .card p {
            color: #666;
            line-height: 1.6;
        }

        /* ---------- Footer ---------- */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 25px;
        }

        /* ---------- Mobile ---------- */
        @media (max-width: 700px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            .nav-links {
                gap: 15px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .hero p {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- Navigation Bar -->
    <nav>
        <div class="logo">MyWebsite</div>

        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Home Section -->
    <section class="hero" id="home">
        <div>
            <h1>Welcome to My Website</h1>

            <p>
                A simple, modern and responsive website
                created using HTML and CSS.
            </p>

            <a href="#services" class="btn">Explore More</a>
        </div>
    </section>

    <!-- About Section -->
    <section class="services" id="about">
        <h2>About Us</h2>

        <div class="cards">

            <div class="card">
                <h3>Who We Are</h3>
                <p>
                    We create simple and beautiful websites
                    for learning and practice.
                </p>
            </div>

            <div class="card">
                <h3>Our Goal</h3>
                <p>
                    Our goal is to build fast, modern and
                    mobile-friendly websites.
                </p>
            </div>

        </div>
    </section>

    <!-- Services Section -->
    <section class="services" id="services">
        <h2>Our Services</h2>

        <div class="cards">

            <div class="card">
                <h3>🌐 Web Design</h3>
                <p>
                    Modern and responsive website designs.
                </p>
            </div>

            <div class="card">
                <h3>💻 Development</h3>
                <p>
                    Websites built using HTML, CSS and JavaScript.
                </p>
            </div>

            <div class="card">
                <h3>📱 Responsive</h3>
                <p>
                    Websites that work properly on mobile,
                    tablet and desktop.
                </p>
            </div>

        </div>
    </section>

    <!-- Contact Section -->
    <section class="services" id="contact">
        <h2>Contact Us</h2>

        <div class="card" style="margin: auto;">
            <h3>Get In Touch</h3>

            <p>
                Email: example@gmail.com
            </p>

            <br>

            <a href="mailto:example@gmail.com" class="btn">
                Contact Now
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 MyWebsite. All Rights Reserved.</p>
    </footer>

</body>
</html>
