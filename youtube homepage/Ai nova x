<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NovaX - Modern Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b0f19;
            color: white;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(11, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
        }

        .logo span {
            color: #00d9ff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #00d9ff;
        }

        .menu {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 100px 20px 50px;
            background:
                radial-gradient(circle at top left, #063c50, transparent 35%),
                radial-gradient(circle at bottom right, #241052, transparent 35%),
                #0b0f19;
        }

        .hero-content {
            max-width: 850px;
            animation: fadeUp 1s ease;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 85px);
            line-height: 1;
            margin-bottom: 25px;
        }

        .hero h1 span {
            color: #00d9ff;
        }

        .hero p {
            color: #b8c0cc;
            font-size: 18px;
            line-height: 1.7;
            margin-bottom: 35px;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 30px;
            background: #00d9ff;
            color: #061018;
            text-decoration: none;
            font-weight: bold;
            margin: 5px;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(0, 217, 255, 0.3);
        }

        .btn-outline {
            background: transparent;
            color: white;
            border: 1px solid #394454;
        }

        /* SECTIONS */
        section {
            padding: 100px 8%;
        }

        .title {
            text-align: center;
            margin-bottom: 50px;
        }

        .title h2 {
            font-size: 42px;
            margin-bottom: 12px;
        }

        .title p {
            color: #9ba5b5;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            padding: 35px;
            background: #111827;
            border: 1px solid #1f2937;
            border-radius: 20px;
            transition: 0.4s;
        }

        .card:hover {
            transform: translateY(-10px);
            border-color: #00d9ff;
        }

        .icon {
            font-size: 40px;
            margin-bottom: 20px;
        }

        .card h3 {
            margin-bottom: 15px;
            font-size: 22px;
        }

        .card p {
            color: #9ba5b5;
            line-height: 1.7;
        }

        /* ABOUT */
        .about {
            background: #0e1420;
        }

        .about-box {
            max-width: 850px;
            margin: auto;
            text-align: center;
        }

        .about-box p {
            color: #aeb7c5;
            line-height: 1.9;
            font-size: 17px;
        }

        /* CONTACT */
        .contact-form {
            max-width: 650px;
            margin: auto;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 16px;
            margin-bottom: 18px;
            border: 1px solid #293444;
            border-radius: 10px;
            background: #111827;
            color: white;
            outline: none;
        }

        .contact-form textarea {
            height: 150px;
            resize: none;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #00d9ff;
        }

        .submit {
            width: 100%;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        /* FOOTER */
        footer {
            padding: 30px;
            text-align: center;
            background: #070b12;
            color: #7f8a99;
        }

        /* ANIMATION */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* MOBILE */
        @media (max-width: 768px) {

            nav ul {
                display: none;
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                flex-direction: column;
                text-align: center;
                padding: 25px;
                background: #0b0f19;
            }

            nav ul.active {
                display: flex;
            }

            .menu {
                display: block;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            section {
                padding: 80px 6%;
            }

            .hero h1 {
                font-size: 50px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <div class="logo">Nova<span>X</span></div>

        <div class="menu" onclick="toggleMenu()">☰</div>

        <ul id="navLinks">
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>


    <!-- HOME -->
    <section class="hero" id="home">

        <div class="hero-content">

            <h1>
                Build Your
                <span>Digital Future.</span>
            </h1>

            <p>
                We create modern, fast and beautiful digital
                experiences that help businesses grow online.
            </p>

            <a href="#services" class="btn">
                Explore Services
            </a>

            <a href="#contact" class="btn btn-outline">
                Contact Us
            </a>

        </div>

    </section>


    <!-- SERVICES -->
    <section id="services">

        <div class="title">
            <h2>Our Services</h2>
            <p>Everything you need to build your online presence.</p>
        </div>

        <div class="cards">

            <div class="card">
                <div class="icon">💻</div>
                <h3>Web Development</h3>
                <p>
                    Modern responsive websites built with clean
                    and optimized code.
                </p>
            </div>

            <div class="card">
                <div class="icon">🎨</div>
                <h3>UI/UX Design</h3>
                <p>
                    Beautiful interfaces designed to provide
                    an excellent user experience.
                </p>
            </div>

            <div class="card">
                <div class="icon">🚀</div>
                <h3>Digital Growth</h3>
                <p>
                    Strategies and solutions designed to help
                    your digital business grow.
                </p>
            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section class="about" id="about">

        <div class="about-box">

            <div class="title">
                <h2>About NovaX</h2>
            </div>

            <p>
                NovaX is a modern digital studio focused on creating
                powerful websites and digital experiences. Our goal is
                simple: combine clean design, modern technology and
                great user experience to create websites people love.
            </p>

        </div>

    </section>


    <!-- CONTACT -->
    <section id="contact">

        <div class="title">
            <h2>Let's Work Together</h2>
            <p>Have a project in mind? Send us a message.</p>
        </div>

        <form class="contact-form" onsubmit="sendMessage(event)">

            <input
                type="text"
                placeholder="Your Name"
                required
            >

            <input
                type="email"
                placeholder="Your Email"
                required
            >

            <textarea
                placeholder="Your Message"
                required
            ></textarea>

            <button class="btn submit">
                Send Message
            </button>

        </form>

    </section>


    <!-- FOOTER -->
    <footer>
        <p>© 2026 NovaX. All Rights Reserved.</p>
    </footer>


    <script>

        // Mobile menu
        function toggleMenu() {
            document
                .getElementById("navLinks")
                .classList.toggle("active");
        }


        // Contact form
        function sendMessage(event) {

            event.preventDefault();

            alert("Message sent successfully! 🚀");

            event.target.reset();
        }


        // Close mobile menu after clicking a link
        document.querySelectorAll("#navLinks a").forEach(link => {

            link.addEventListener("click", () => {

                document
                    .getElementById("navLinks")
                    .classList.remove("active");

            });

        });

    </script>

</body>
</html>
