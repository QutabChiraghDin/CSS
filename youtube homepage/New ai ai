<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Modern Website</title>

    <style>
        /* ===== BASIC SETTINGS ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0f172a;
            color: white;
        }

        /* ===== NAVBAR ===== */
        nav {
            width: 100%;
            padding: 18px 8%;
            background: #111827;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: fixed;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(0,0,0,0.3);
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #38bdf8;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
            transition: 0.3s;
        }

        nav ul li a:hover {
            color: #38bdf8;
        }

        /* ===== HOME ===== */
        .home {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 100px 20px 50px;
            background: linear-gradient(135deg, #0f172a, #1e3a8a);
        }

        .home-content {
            max-width: 700px;
        }

        .home h1 {
            font-size: 55px;
            margin-bottom: 20px;
        }

        .home h1 span {
            color: #38bdf8;
        }

        .home p {
            font-size: 18px;
            line-height: 1.7;
            color: #cbd5e1;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 28px;
            background: #38bdf8;
            color: #0f172a;
            text-decoration: none;
            border-radius: 30px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-4px);
            background: white;
        }

        /* ===== GENERAL SECTION ===== */
        section {
            padding: 100px 8%;
            min-height: 70vh;
        }

        .title {
            text-align: center;
            font-size: 38px;
            margin-bottom: 50px;
        }

        .title span {
            color: #38bdf8;
        }

        /* ===== ABOUT ===== */
        .about {
            background: #111827;
        }

        .about-container {
            display: flex;
            justify-content: center;
            gap: 40px;
            flex-wrap: wrap;
        }

        .card {
            width: 280px;
            padding: 30px;
            background: #1e293b;
            border-radius: 15px;
            text-align: center;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(56,189,248,0.2);
        }

        .card h3 {
            color: #38bdf8;
            margin-bottom: 15px;
        }

        .card p {
            color: #cbd5e1;
            line-height: 1.6;
        }

        /* ===== CONTACT ===== */
        .contact {
            background: #0f172a;
        }

        form {
            max-width: 600px;
            margin: auto;
        }

        input,
        textarea {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            outline: none;
            border-radius: 8px;
            background: #1e293b;
            color: white;
            font-size: 16px;
        }

        textarea {
            height: 150px;
            resize: none;
        }

        form button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 8px;
            background: #38bdf8;
            color: #0f172a;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        form button:hover {
            background: white;
        }

        /* ===== FOOTER ===== */
        footer {
            text-align: center;
            padding: 25px;
            background: #111827;
            color: #94a3b8;
        }

        /* ===== MOBILE RESPONSIVE ===== */
        @media (max-width: 700px) {

            nav {
                padding: 15px 5%;
            }

            nav ul {
                gap: 12px;
            }

            nav ul li a {
                font-size: 13px;
            }

            .logo {
                font-size: 20px;
            }

            .home h1 {
                font-size: 40px;
            }

            .home p {
                font-size: 16px;
            }

            section {
                padding: 80px 5%;
            }

            .title {
                font-size: 30px;
            }

            .card {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav>
        <div class="logo">MyWebsite</div>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>


    <!-- ===== HOME SECTION ===== -->
    <section class="home" id="home">

        <div class="home-content">

            <h1>
                Welcome to <span>My Website</span>
            </h1>

            <p>
                This is a modern and responsive website created
                using HTML and CSS. You can customize it according
                to your own project.
            </p>

            <a href="#about" class="btn">
                Explore More
            </a>

        </div>

    </section>


    <!-- ===== ABOUT SECTION ===== -->
    <section class="about" id="about">

        <h2 class="title">
            About <span>Us</span>
        </h2>

        <div class="about-container">

            <div class="card">
                <h3>Web Design</h3>

                <p>
                    We create clean and modern website designs
                    that work on both mobile and desktop devices.
                </p>
            </div>


            <div class="card">
                <h3>Development</h3>

                <p>
                    We use modern HTML and CSS techniques to
                    create beautiful and user-friendly websites.
                </p>
            </div>


            <div class="card">
                <h3>Responsive</h3>

                <p>
                    Our websites are designed to look good on
                    phones, tablets and computers.
                </p>
            </div>

        </div>

    </section>


    <!-- ===== CONTACT SECTION ===== -->
    <section class="contact" id="contact">

        <h2 class="title">
            Contact <span>Us</span>
        </h2>

        <form>

            <input
                type="text"
                placeholder="Enter your name"
                required
            >

            <input
                type="email"
                placeholder="Enter your email"
                required
            >

            <textarea
                placeholder="Write your message..."
                required
            ></textarea>

            <button type="submit">
                Send Message
            </button>

        </form>

    </section>


    <!-- ===== FOOTER ===== -->
    <footer>
        <p>© 2026 MyWebsite. All Rights Reserved.</p>
    </footer>

</body>
</html>
