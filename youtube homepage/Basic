<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nova Studio</title>

    <style>
        /* ---------- RESET ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            color: #172033;
            background: #ffffff;
            line-height: 1.6;
        }

        /* ---------- NAVBAR ---------- */
        nav {
            width: 100%;
            padding: 20px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            background: white;
            z-index: 1000;
            box-shadow: 0 2px 15px rgba(0,0,0,0.05);
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #4f46e5;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: #172033;
            font-weight: 500;
        }

        .nav-links a:hover {
            color: #4f46e5;
        }

        .menu-btn {
            display: none;
            font-size: 28px;
            cursor: pointer;
        }

        /* ---------- HERO ---------- */
        .hero {
            min-height: 90vh;
            padding: 80px 8%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 50px;
            background: linear-gradient(135deg, #f8faff, #eef2ff);
        }

        .hero-text {
            max-width: 600px;
            animation: slideLeft 1s ease;
        }

        .hero-text h1 {
            font-size: clamp(42px, 6vw, 70px);
            line-height: 1.1;
            margin-bottom: 20px;
        }

        .hero-text h1 span {
            color: #4f46e5;
        }

        .hero-text p {
            font-size: 18px;
            color: #64748b;
            margin-bottom: 30px;
        }

        .buttons {
            display: flex;
            gap: 15px;
        }

        .btn {
            padding: 13px 25px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .primary {
            background: #4f46e5;
            color: white;
        }

        .primary:hover {
            transform: translateY(-3px);
            background: #3730a3;
        }

        .secondary {
            border: 2px solid #4f46e5;
            color: #4f46e5;
        }

        .secondary:hover {
            background: #4f46e5;
            color: white;
        }

        /* ---------- HERO IMAGE ---------- */
        .hero-image {
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: linear-gradient(135deg, #4f46e5, #9333ea);
            display: flex;
            justify-content: center;
            align-items: center;
            animation: float 4s ease-in-out infinite;
            box-shadow: 0 30px 80px rgba(79,70,229,0.3);
        }

        .hero-image div {
            width: 230px;
            height: 230px;
            border-radius: 30px;
            background: rgba(255,255,255,0.2);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.4);
        }

        /* ---------- SERVICES ---------- */
        .services {
            padding: 100px 8%;
            text-align: center;
        }

        .section-title {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .section-subtitle {
            color: #64748b;
            margin-bottom: 50px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            padding: 35px 25px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 35px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
        }

        .icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #64748b;
        }

        /* ---------- ABOUT ---------- */
        .about {
            padding: 100px 8%;
            background: #f8faff;
            text-align: center;
        }

        .about p {
            max-width: 700px;
            margin: auto;
            color: #64748b;
        }

        /* ---------- CONTACT ---------- */
        .contact {
            padding: 100px 8%;
            text-align: center;
        }

        .contact button {
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        /* ---------- FOOTER ---------- */
        footer {
            padding: 30px;
            text-align: center;
            background: #111827;
            color: white;
        }

        /* ---------- ANIMATIONS ---------- */
        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        @keyframes slideLeft {
            from {
                opacity: 0;
                transform: translateX(-50px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* ---------- MOBILE ---------- */
        @media (max-width: 768px) {

            .menu-btn {
                display: block;
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 70px;
                left: 0;
                width: 100%;
                background: white;
                flex-direction: column;
                text-align: center;
                padding: 20px;
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

            .nav-links.active {
                display: flex;
            }

            .hero {
                flex-direction: column;
                text-align: center;
                padding-top: 60px;
            }

            .buttons {
                justify-content: center;
                flex-wrap: wrap;
            }

            .hero-image {
                width: 280px;
                height: 280px;
            }

            .hero-image div {
                width: 160px;
                height: 160px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .section-title {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <div class="logo">Nova Studio</div>

        <div class="menu-btn" onclick="toggleMenu()">☰</div>

        <ul class="nav-links" id="navLinks">
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>


    <!-- HERO -->
    <section class="hero" id="home">

        <div class="hero-text">
            <h1>Build Something <span>Amazing</span></h1>

            <p>
                We create simple, beautiful and modern digital
                experiences for everyone.
            </p>

            <div class="buttons">
                <a href="#services" class="btn primary">Get Started</a>
                <a href="#about" class="btn secondary">Learn More</a>
            </div>
        </div>

        <div class="hero-image">
            <div></div>
        </div>

    </section>


    <!-- SERVICES -->
    <section class="services" id="services">

        <h2 class="section-title">Our Services</h2>

        <p class="section-subtitle">
            Everything you need to build your online presence.
        </p>

        <div class="cards">

            <div class="card">
                <div class="icon">💻</div>
                <h3>Web Design</h3>
                <p>
                    Modern and responsive websites that look great
                    on every device.
                </p>
            </div>

            <div class="card">
                <div class="icon">⚙️</div>
                <h3>Development</h3>
                <p>
                    Fast and functional websites using modern
                    technologies.
                </p>
            </div>

            <div class="card">
                <div class="icon">💡</div>
                <h3>Creative Ideas</h3>
                <p>
                    Creative digital solutions designed around
                    your ideas and goals.
                </p>
            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section class="about" id="about">

        <h2 class="section-title">About Us</h2>

        <p>
            Nova Studio is a simple example of a modern website.
            You can customize this template and use it for your
            portfolio, business, startup or personal project.
        </p>

    </section>


    <!-- CONTACT -->
    <section class="contact" id="contact">

        <h2 class="section-title">Let's Work Together</h2>

        <p class="section-subtitle">
            Have an idea? Let's turn it into reality.
        </p>

        <button class="btn primary" onclick="showMessage()">
            Contact Us
        </button>

    </section>


    <!-- FOOTER -->
    <footer>
        <p>© 2026 Nova Studio. All Rights Reserved.</p>
    </footer>


    <!-- JAVASCRIPT -->
    <script>

        // Mobile menu
        function toggleMenu() {
            document.getElementById("navLinks")
                .classList.toggle("active");
        }

        // Contact button
        function showMessage() {
            alert("Thanks for contacting us! 🚀");
        }

    </script>

</body>
</html>
