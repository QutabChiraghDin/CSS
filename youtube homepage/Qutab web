<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #0b1020;
            color: white;
        }

        /* NAVBAR */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(11, 16, 32, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            color: #00e5ff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #00e5ff;
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 100px 20px;
            background:
                radial-gradient(circle at 20% 20%, #173c78, transparent 35%),
                radial-gradient(circle at 80% 80%, #471b70, transparent 35%),
                #0b1020;
        }

        .hero-content {
            animation: fadeUp 1.2s ease;
        }

        .hero h1 {
            font-size: clamp(45px, 8vw, 85px);
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #00e5ff;
        }

        .hero p {
            max-width: 650px;
            margin: auto;
            color: #c8c8d0;
            font-size: 18px;
            line-height: 1.7;
        }

        .btn {
            display: inline-block;
            margin-top: 30px;
            padding: 14px 30px;
            border-radius: 30px;
            background: #00e5ff;
            color: #071018;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 229, 255, 0.4);
        }

        /* SECTIONS */
        section {
            padding: 100px 8%;
            min-height: 100vh;
        }

        .title {
            text-align: center;
            margin-bottom: 50px;
        }

        .title h2 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .title p {
            color: #aaa;
        }

        /* CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            padding: 35px;
            border-radius: 20px;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.1);
            transition: 0.4s;
        }

        .card:hover {
            transform: translateY(-12px);
            border-color: #00e5ff;
            box-shadow: 0 15px 40px rgba(0,229,255,0.15);
        }

        .card h3 {
            color: #00e5ff;
            margin-bottom: 15px;
            font-size: 24px;
        }

        .card p {
            color: #bbb;
            line-height: 1.7;
        }

        /* ABOUT */
        .about {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 50px;
        }

        .about-text {
            flex: 1;
        }

        .about-text h2 {
            font-size: 45px;
            margin-bottom: 20px;
        }

        .about-text p {
            color: #bbb;
            line-height: 1.8;
        }

        .about-box {
            flex: 1;
            height: 350px;
            border-radius: 30px;
            background: linear-gradient(135deg, #00e5ff, #7c3aed);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 80px;
            animation: float 4s ease-in-out infinite;
        }

        /* CONTACT */
        .contact-box {
            max-width: 700px;
            margin: auto;
            padding: 40px;
            background: rgba(255,255,255,0.06);
            border-radius: 20px;
        }

        input,
        textarea {
            width: 100%;
            padding: 15px;
            margin-bottom: 15px;
            border: none;
            outline: none;
            border-radius: 10px;
            background: #151c32;
            color: white;
        }

        textarea {
            height: 150px;
            resize: none;
        }

        button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 10px;
            background: #00e5ff;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }

        button:hover {
            transform: scale(1.03);
        }

        /* FOOTER */
        footer {
            text-align: center;
            padding: 30px;
            background: #070b16;
            color: #888;
        }

        /* ANIMATIONS */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-15px);
            }
        }

        /* MOBILE */
        @media (max-width: 768px) {

            nav {
                padding: 15px 5%;
            }

            nav ul {
                gap: 12px;
                font-size: 14px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .about {
                flex-direction: column;
            }

            .about-box {
                width: 100%;
            }

            section {
                padding: 80px 5%;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <div class="logo">QUTAB</div>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#services">Services</a></li>
            <li><a href="#about">About</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>


    <!-- HOME PAGE -->
    <section class="hero" id="home">

        <div class="hero-content">

            <h1>Build Your <span>Future</span></h1>

            <p>
                A modern responsive website created using only
                HTML and CSS. Fast, clean and mobile friendly.
            </p>

            <a href="#services" class="btn">
                Explore More
            </a>

        </div>

    </section>


    <!-- SERVICES PAGE -->
    <section id="services">

        <div class="title">
            <h2>Our Services</h2>
            <p>What we can create for you</p>
        </div>

        <div class="cards">

            <div class="card">
                <h3>Web Design</h3>
                <p>
                    Modern and responsive websites with
                    attractive layouts and smooth animations.
                </p>
            </div>

            <div class="card">
                <h3>Development</h3>
                <p>
                    Clean HTML, CSS and JavaScript solutions
                    for modern web applications.
                </p>
            </div>

            <div class="card">
                <h3>UI/UX Design</h3>
                <p>
                    Simple and user-friendly interfaces designed
                    for a better user experience.
                </p>
            </div>

        </div>

    </section>


    <!-- ABOUT PAGE -->
    <section id="about">

        <div class="about">

            <div class="about-text">

                <h2>About Us</h2>

                <p>
                    We create modern digital experiences using
                    simple technologies. Our goal is to build
                    websites that look professional, work smoothly
                    and are easy to use on mobile and desktop.
                </p>

                <a href="#contact" class="btn">
                    Contact Us
                </a>

            </div>

            <div class="about-box">
                🚀
            </div>

        </div>

    </section>


    <!-- CONTACT PAGE -->
    <section id="contact">

        <div class="title">
            <h2>Contact Us</h2>
            <p>Let's build something amazing</p>
        </div>

        <div class="contact-box">

            <input type="text" placeholder="Your Name">

            <input type="email" placeholder="Your Email">

            <textarea placeholder="Your Message"></textarea>

            <button onclick="sendMessage()">
                Send Message
            </button>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>
        <p>© 2026 Qutab. All Rights Reserved.</p>
    </footer>


    <script>
        // Simple contact button
        function sendMessage() {
            alert("Your message has been sent!");
        }
    </script>

</body>
</html>
