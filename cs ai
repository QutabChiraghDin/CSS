<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Men's Suit Fashion</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #222;
        }

        /* NAVBAR */
        nav {
            background: #111827;
            padding: 18px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 35px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav a {
            color: white;
            text-decoration: none;
            font-size: 17px;
            font-weight: bold;
            padding: 10px 18px;
            border-radius: 8px;
            transition: 0.3s;
        }

        nav a:hover {
            background: #2563eb;
        }

        /* HERO */
        .hero {
            min-height: 90vh;
            background: linear-gradient(
                rgba(0,0,0,0.65),
                rgba(0,0,0,0.65)
            ),
            url("https://images.unsplash.com/photo-1594938298603-c8148c4dae35?auto=format&fit=crop&w=1600&q=80");

            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            color: white;
            padding: 30px;
        }

        .hero-content h1 {
            font-size: 55px;
            margin-bottom: 20px;
        }

        .hero-content p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            background: #2563eb;
            color: white;
            text-decoration: none;
            padding: 13px 25px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #1d4ed8;
            transform: scale(1.05);
        }

        /* GENERAL SECTIONS */
        section {
            padding: 80px 8%;
            min-height: 100vh;
        }

        .title {
            text-align: center;
            font-size: 40px;
            margin-bottom: 15px;
            color: #111827;
        }

        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 45px;
        }

        /* SUIT CARDS */
        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.12);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-10px);
        }

        .card img {
            width: 100%;
            height: 320px;
            object-fit: cover;
        }

        .card-content {
            padding: 20px;
            text-align: center;
        }

        .card-content h3 {
            margin-bottom: 10px;
            color: #111827;
        }

        .card-content p {
            color: #666;
            line-height: 1.6;
        }

        /* ABOUT PAGE */
        #about {
            background: #eaf0f6;
        }

        .about-box {
            max-width: 900px;
            margin: auto;
            background: white;
            padding: 40px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            text-align: center;
        }

        .about-box p {
            line-height: 1.8;
            color: #555;
            margin: 20px 0;
        }

        /* CONTACT PAGE */
        .contact-box {
            max-width: 600px;
            margin: auto;
            background: white;
            padding: 35px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .contact-box input,
        .contact-box textarea {
            width: 100%;
            padding: 14px;
            margin-bottom: 18px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
        }

        .contact-box textarea {
            height: 140px;
            resize: none;
        }

        .contact-box button {
            width: 100%;
            padding: 14px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 17px;
            cursor: pointer;
        }

        .contact-box button:hover {
            background: #1d4ed8;
        }

        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* RESPONSIVE */
        @media (max-width: 900px) {
            .cards {
                grid-template-columns: repeat(2, 1fr);
            }

            .hero-content h1 {
                font-size: 42px;
            }
        }

        @media (max-width: 600px) {
            nav {
                flex-wrap: wrap;
                gap: 10px;
            }

            nav a {
                font-size: 14px;
                padding: 8px 12px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .hero-content h1 {
                font-size: 34px;
            }

            .hero-content p {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav>
        <a href="#home">Home</a>
        <a href="#suits">Men's Suits</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
    </nav>


    <!-- PAGE 1: HOME -->
    <section id="home" class="hero">

        <div class="hero-content">

            <h1>Men's Suit Fashion</h1>

            <p>
                Discover modern, classic and elegant suits for every occasion.
            </p>

            <a href="#suits" class="btn">Explore Suits</a>

        </div>

    </section>


    <!-- PAGE 2: SUITS -->
    <section id="suits">

        <h2 class="title">Men's Suit Collection</h2>

        <p class="subtitle">
            Choose the perfect suit for your style and occasion.
        </p>

        <div class="cards">

            <div class="card">

                <img src="https://images.unsplash.com/photo-1598808503746-f34c53b9323e?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Two-Piece Suit</h3>

                    <p>
                        A classic jacket and trousers combination,
                        perfect for business and formal events.
                    </p>

                </div>

            </div>


            <div class="card">

                <img src="https://images.unsplash.com/photo-1555069519-127aadedf1ee?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Three-Piece Suit</h3>

                    <p>
                        A stylish combination of jacket, trousers
                        and waistcoat for an elegant appearance.
                    </p>

                </div>

            </div>


            <div class="card">

                <img src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Business Suit</h3>

                    <p>
                        Professional and sophisticated style
                        suitable for meetings and office events.
                    </p>

                </div>

            </div>


            <div class="card">

                <img src="https://images.unsplash.com/photo-1593032465175-481ac7f401a0?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Wedding Suit</h3>

                    <p>
                        Elegant suit styles designed for weddings,
                        receptions and special occasions.
                    </p>

                </div>

            </div>


            <div class="card">

                <img src="https://images.unsplash.com/photo-1551488831-00ddcb6c6bd3?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Tuxedo</h3>

                    <p>
                        A sophisticated formal outfit designed
                        for evening and black-tie events.
                    </p>

                </div>

            </div>


            <div class="card">

                <img src="https://images.unsplash.com/photo-1617127365659-c47fa864d8bc?auto=format&fit=crop&w=800&q=80">

                <div class="card-content">

                    <h3>Casual Suit</h3>

                    <p>
                        A relaxed and modern suit style for
                        smart-casual occasions.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- PAGE 3: ABOUT -->
    <section id="about">

        <h2 class="title">About Our Fashion</h2>

        <div class="about-box">

            <h2>Modern Men's Fashion</h2>

            <p>
                Welcome to Men's Suit Fashion. Our website is designed
                to showcase different suit styles for men.
            </p>

            <p>
                From classic two-piece suits to elegant tuxedos,
                explore different styles and find inspiration for
                your next formal or casual look.
            </p>

            <a href="#contact" class="btn">Contact Us</a>

        </div>

    </section>


    <!-- CONTACT -->
    <section id="contact">

        <h2 class="title">Contact Us</h2>

        <p class="subtitle">
            Have a question? Send us a message.
        </p>

        <div class="contact-box">

            <input type="text" placeholder="Your Name">

            <input type="email" placeholder="Your Email">

            <textarea placeholder="Your Message"></textarea>

            <button type="submit">Send Message</button>

        </div>

    </section>


    <footer>
        <p>© 2026 Men's Suit Fashion | All Rights Reserved</p>
    </footer>

</body>
</html>