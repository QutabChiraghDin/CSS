<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f4f7fb;
            color: #222;
        }

        /* Navbar */
        nav {
            background: #111827;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-size: 16px;
        }

        nav ul li a:hover {
            color: #38bdf8;
        }

        /* Hero Section */
        .hero {
            min-height: 80vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
        }

        .hero-content {
            max-width: 700px;
        }

        .hero h1 {
            font-size: 50px;
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: #0ea5e9;
        }

        .hero p {
            font-size: 18px;
            color: #555;
            line-height: 1.6;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            background: #0ea5e9;
            color: white;
            padding: 14px 28px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: #0284c7;
            transform: translateY(-3px);
        }

        /* Cards */
        .cards {
            display: flex;
            justify-content: center;
            gap: 20px;
            padding: 50px 8%;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            width: 280px;
            padding: 30px;
            text-align: center;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
        }

        .card h2 {
            margin-bottom: 15px;
        }

        .card p {
            color: #666;
            line-height: 1.5;
        }

        /* Footer */
        footer {
            background: #111827;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 30px;
        }

        /* Mobile */
        @media (max-width: 600px) {

            nav {
                flex-direction: column;
                gap: 15px;
            }

            nav ul {
                gap: 15px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .hero p {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav>
        <div class="logo">MyWebsite</div>

        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Services</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <!-- Hero -->
    <section class="hero">
        <div class="hero-content">

            <h1>Welcome to <span>My Website</span></h1>

            <p>
                This is a simple and modern website created
                using HTML and CSS. You can customize it
                according to your project.
            </p>

            <a href="#" class="btn">Get Started</a>

        </div>
    </section>

    <!-- Cards -->
    <section class="cards">

        <div class="card">
            <h2>Web Design</h2>
            <p>
                Create beautiful and responsive websites
                using HTML and CSS.
            </p>
        </div>

        <div class="card">
            <h2>Development</h2>
            <p>
                Build modern websites and web applications
                with clean code.
            </p>
        </div>

        <div class="card">
            <h2>Responsive</h2>
            <p>
                Make your website work perfectly on mobile,
                tablet and desktop.
            </p>
        </div>

    </section>

    <!-- Footer -->
    <footer>
        <p>© 2026 MyWebsite. All Rights Reserved.</p>
    </footer>

</body>
</html>
