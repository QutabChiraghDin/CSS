<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Animated Neon Login</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            height: 100vh;
            overflow: hidden;
            font-family: Arial, sans-serif;

            display: flex;
            justify-content: center;
            align-items: center;

            background: #090014;
        }

        /* =========================
           ANIMATED BACKGROUND
        ========================== */

        .background {
            position: fixed;
            width: 100%;
            height: 100%;

            background:
                radial-gradient(
                    circle at 20% 30%,
                    #ff7b00,
                    transparent 25%
                ),

                radial-gradient(
                    circle at 80% 20%,
                    #9d00ff,
                    transparent 30%
                ),

                radial-gradient(
                    circle at 50% 80%,
                    #ff006a,
                    transparent 30%
                ),

                #090014;

            filter: blur(30px);

            animation: backgroundMove 10s ease-in-out infinite alternate;

            z-index: -2;
        }

        @keyframes backgroundMove {

            0% {
                transform: scale(1) rotate(0deg);
            }

            50% {
                transform: scale(1.3) rotate(8deg);
            }

            100% {
                transform: scale(1.1) rotate(-8deg);
            }
        }


        /* Dark overlay */

        .overlay {
            position: fixed;
            inset: 0;

            background: rgba(0, 0, 0, 0.45);

            z-index: -1;
        }


        /* =========================
           LOGIN CARD
        ========================== */

        .login-box {

            width: 370px;

            padding: 40px;

            background: rgba(20, 5, 30, 0.65);

            border: 2px solid #ff9900;

            border-radius: 25px;

            backdrop-filter: blur(20px);

            box-shadow:
                0 0 10px #ff9900,
                0 0 30px #ff6600,
                inset 0 0 20px #ff990033;

            animation: cardFloat 4s ease-in-out infinite;
        }

        @keyframes cardFloat {

            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }


        /* =========================
           HEADING
        ========================== */

        h1 {

            text-align: center;

            margin-bottom: 30px;

            font-size: 38px;

            color: #ff9900;

            text-shadow:
                0 0 5px #ff9900,
                0 0 15px #ff6600,
                0 0 30px #ff3300;
        }


        /* =========================
           INPUTS
        ========================== */

        .input-box {
            margin-bottom: 22px;
        }

        .input-box label {

            display: block;

            margin-bottom: 8px;

            color: #ffffff;

            font-size: 15px;
        }

        .input-box input {

            width: 100%;

            padding: 14px;

            background: rgba(0, 0, 0, 0.3);

            border: 2px solid #9d00ff;

            border-radius: 12px;

            outline: none;

            color: white;

            font-size: 16px;

            box-shadow:
                0 0 8px #9d00ff;

            transition: 0.3s;
        }

        .input-box input:focus {

            border-color: #ff9900;

            box-shadow:
                0 0 10px #ff9900,
                0 0 25px #ff6600;
        }

        input::placeholder {
            color: #bbbbbb;
        }


        /* =========================
           OPTIONS
        ========================== */

        .options {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 25px;

            color: white;

            font-size: 14px;
        }

        .options a {

            color: #ff9900;

            text-decoration: none;

            text-shadow: 0 0 8px #ff9900;
        }

        .options a:hover {
            color: #ff006a;
        }


        /* =========================
           LOGIN BUTTON
        ========================== */

        .login-btn {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 12px;

            background: linear-gradient(
                90deg,
                #ff6600,
                #ff9900,
                #ff006a
            );

            color: white;

            font-size: 18px;

            font-weight: bold;

            cursor: pointer;

            box-shadow:
                0 0 10px #ff6600,
                0 0 25px #ff0066;

            transition: 0.3s;
        }

        .login-btn:hover {

            transform: scale(1.05);

            box-shadow:
                0 0 15px #ff9900,
                0 0 35px #ff0066,
                0 0 60px #9d00ff;
        }


        /* =========================
           REGISTER
        ========================== */

        .register {

            margin-top: 25px;

            text-align: center;

            color: white;
        }

        .register a {

            color: #ff006a;

            text-decoration: none;

            font-weight: bold;

            text-shadow:
                0 0 8px #ff006a;
        }


        /* =========================
           MOBILE
        ========================== */

        @media (max-width: 450px) {

            .login-box {

                width: 90%;

                padding: 30px;
            }

            h1 {
                font-size: 32px;
            }
        }

    </style>
</head>

<body>

    <!-- Animated wallpaper -->
    <div class="background"></div>

    <!-- Dark overlay -->
    <div class="overlay"></div>


    <!-- Login Card -->

    <div class="login-box">

        <h1>LOGIN</h1>

        <form>

            <div class="input-box">

                <label>Email</label>

                <input
                    type="email"
                    placeholder="Enter your email"
                    required
                >

            </div>


            <div class="input-box">

                <label>Password</label>

                <input
                    type="password"
                    placeholder="Enter your password"
                    required
                >

            </div>


            <div class="options">

                <label>
                    <input type="checkbox">
                    Remember me
                </label>

                <a href="#">
                    Forgot Password?
                </a>

            </div>


            <button
                type="submit"
                class="login-btn"
            >
                LOGIN
            </button>

        </form>


        <div class="register">

            Don't have an account?

            <a href="#">
                Register
            </a>

        </div>

    </div>

</body>
</html>